# Copie ce fichier en .env pour le dev local — valeurs bidon, jamais de vrai secret ici.

# --- Postgres ---
POSTGRES_USER=bresonne
POSTGRES_PASSWORD=bresonne
POSTGRES_DB=bresonne
DATABASE_URL=postgresql+psycopg://bresonne:bresonne@db:5432/bresonne

# --- MinIO (stockage objet, remplace S3 — gratuit, local) ---
MINIO_ROOT_USER=bresonneminio
MINIO_ROOT_PASSWORD=bresonneminio
# Nom de service Docker : utilisé par le backend pour parler à MinIO à l'intérieur du réseau compose.
MINIO_ENDPOINT=minio:9000
# Hôte réellement joignable par un navigateur/l'app mobile : sert uniquement à signer les URLs
# de téléchargement des photos. À adapter si le port MinIO change (voir README, conflits de ports).
# Pour un bêta-test entre proches sur le même réseau local (pas de VPS — voir docs/V2_FEATURES.md) :
# remplacer "localhost" par l'IP LAN de cette machine (ex. 192.168.1.39, `hostname -I`), sinon les
# photos privées ne s'afficheront que sur ce poste — "localhost" sur l'appareil d'un·e testeur·se
# ne désigne que lui-même, jamais cette machine.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=bresonne-photos
MINIO_SECURE=false
# Clé KMS locale à un seul secret : chiffrement au repos (SSE-S3) sans dépendance externe
# (cahier des charges A.9/D.10). Format "<id>:<clé base64 32 octets>", génère la tienne avec :
# python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MINIO_KMS_SECRET_KEY=bresonne-dev-key:CHANGE_ME_32_BYTES_BASE64==

# --- Auth ---
JWT_SECRET=changeme-dev-only
JWT_ALGORITHM=HS256
# 15 jours : rester connecté d'une session à l'autre plutôt qu'une expiration courte — au-delà,
# reconnexion par OTP téléphone (pas de refresh token séparé, voir core/config.py).
ACCESS_TOKEN_EXPIRE_MINUTES=21600

# --- OTP (stub gratuit/local : pas de SMS réel tant qu'on n'a pas d'opérateur) ---
# En debug, le code envoyé est aussi renvoyé dans la réponse API pour tester sans SMS.
DEBUG_OTP=true

# --- Abonnement (stub gratuit/local : pas de vrai paiement tant qu'il n'y a pas de build store) ---
# Active POST /subscriptions/debug-activate, qui accorde le Premium sans paiement — pratique pour
# tester en local et utilisé par les scripts de seed/tests, mais à laisser à false dans tout
# environnement joignable par de vrais utilisateurs (voir docs/DEPLOYMENT.md).
ENABLE_DEBUG_SUBSCRIPTION_ENDPOINT=true

# --- CORS (Flutter web, Phase 6) ---
# Liste séparée par des virgules. Le Flutter web tourne sur un port différent de l'API :
# sans ça, le navigateur bloque tous les appels. Pour un bêta-test réseau local, ajouter l'IP LAN
# en plus de localhost (le navigateur envoie l'origine réellement utilisée dans sa barre
# d'adresse) : CORS_ORIGINS=http://localhost:5000,http://192.168.1.39:5000
# Pour un tunnel (devtunnels, ngrok...), ajouter l'origine exacte du tunnel qui sert la page (sans
# "/" final — le navigateur ne l'envoie jamais dans l'en-tête Origin, un "/" en trop fait échouer
# la comparaison silencieusement).
CORS_ORIGINS=http://localhost:5000

# API_BASE_URL (mobile/, optionnel) : à définir seulement quand l'app est servie derrière un tunnel
# (devtunnels, ngrok...) plutôt qu'en IP LAN — l'hôte de la page ne suffit alors pas à deviner
# l'adresse de l'API (voir mobile/bresonne_app/lib/api/api_config.dart). Il faut forwarder le port
# 8010 du backend séparément du port 5000 de la page pour obtenir une seconde URL de tunnel, puis
# reconstruire l'app mobile avec cette variable exportée avant `docker compose up mobile` (ou
# `docker compose build mobile` si le conteneur tourne déjà en MOBILE_MODE=serve, qui build une
# fois au démarrage) : API_BASE_URL=https://<le-tunnel-du-port-8010>
API_BASE_URL=

# --- Question du jour personnalisée (service `ollama`, profil "ai", voir docker-compose.yml) ---
# false par défaut : sans le conteneur ollama démarré (`docker compose --profile ai up -d ollama
# ollama-init`), le gabarit statique existant reste utilisé (voir core/config.py,
# services/question_llm.py). Modèle volontairement petit/rapide : la génération se fait de façon
# synchrone, une fois par match/utilisateur/jour, dans la requête qui crée la question du jour.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=3.0

# --- Messagerie temps réel multi-instance (service `redis`, voir docker-compose.yml) ---
# Pub/sub partagé entre instances backend (cahier des charges D.4) : sans ça, deux utilisateurs
# connectés à deux instances backend différentes ne se voient plus. Gratuit/local, aucune donnée
# n'y est durablement stockée (voir docs/DPIA.md) — nom de service Docker, jamais exposé hors du
# réseau compose (pas de port publié).
REDIS_URL=redis://redis:6379/0

# --- Notifications push réelles (Web Push + VAPID, voir docs/V2_FEATURES.md §6) ---
# false par défaut : sans PUSH_ENABLED=true, aucun appel pywebpush n'est jamais tenté (même
# garde-fou que OLLAMA_ENABLED ci-dessus) — ce qui permet aux tests/CI de ne jamais dépendre du
# réseau ni d'une vraie paire de clés.
PUSH_ENABLED=false
# Paire de clés EC (VAPID, RFC 8292) : identifie ce serveur auprès des services de push des
# navigateurs. Gratuit, aucun tiers payant. Génère la tienne avec (py_vapid, dépendance transitive
# de pywebpush) :
# docker compose run --rm backend python3 -c "
# from py_vapid import Vapid02
# from py_vapid.utils import b64urlencode
# from cryptography.hazmat.primitives import serialization
# v = Vapid02(); v.generate_keys()
# priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
# pub = v.public_key.public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)
# print('VAPID_PRIVATE_KEY=' + b64urlencode(priv))
# print('VAPID_PUBLIC_KEY=' + b64urlencode(pub))"
# Le format (urlsafe-base64 sans padding) est directement ce qu'attend pywebpush côté serveur et
# ce que le client passe tel quel comme `applicationServerKey` à PushManager.subscribe().
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_PUBLIC_KEY=CHANGE_ME
# Exigé par la RFC 8292 (contact joignable en cas de souci côté service de push) — une vraie
# adresse en prod, jamais une valeur bidon.
VAPID_SUBJECT=mailto:CHANGE_ME@example.com

# --- Sauvegardes (service `backup`, voir infra/backup/) ---
# Intervalle entre deux sauvegardes automatiques, en secondes (86400 = 1 fois par jour).
BACKUP_INTERVAL_SECONDS=86400
# Nombre de jours de dumps Postgres conservés avant purge (le miroir photos, lui, reste à jour en
# permanence : voir infra/backup/backup.sh).
BACKUP_RETENTION_DAYS=14
