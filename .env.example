# Copie ce fichier en .env pour le dev local — valeurs bidon, jamais de vrai secret ici.

# --- Postgres ---
POSTGRES_USER=braise
POSTGRES_PASSWORD=braise
POSTGRES_DB=braise
DATABASE_URL=postgresql+psycopg://braise:braise@db:5432/braise

# --- MinIO (stockage objet, remplace S3 — gratuit, local) ---
MINIO_ROOT_USER=braiseminio
MINIO_ROOT_PASSWORD=braiseminio
# Nom de service Docker : utilisé par le backend pour parler à MinIO à l'intérieur du réseau compose.
MINIO_ENDPOINT=minio:9000
# Hôte réellement joignable par un navigateur/l'app mobile : sert uniquement à signer les URLs
# de téléchargement des photos. À adapter si le port MinIO change (voir README, conflits de ports).
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=braise-photos
MINIO_SECURE=false

# --- Auth ---
JWT_SECRET=changeme-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OTP (stub gratuit/local : pas de SMS réel tant qu'on n'a pas d'opérateur) ---
# En debug, le code envoyé est aussi renvoyé dans la réponse API pour tester sans SMS.
DEBUG_OTP=true
