# Gabarit pour la production — copie en `.env` sur le VPS (jamais commité, comme `.env` local).
# Toutes les valeurs ci-dessous sont des placeholders : rien ici ne doit survivre tel quel en
# prod. Voir docs/DEPLOYMENT.md pour la checklist complète.

# --- Postgres ---
POSTGRES_USER=bresonne
# Génère un vrai secret : openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bresonne
DATABASE_URL=postgresql+psycopg://bresonne:CHANGE_ME@db:5432/bresonne

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME
# openssl rand -base64 24
MINIO_ROOT_PASSWORD=CHANGE_ME
# Nom de service Docker interne — ne change jamais, même en prod (trafic conteneur-à-conteneur).
MINIO_ENDPOINT=minio:9000
# Domaine public réel des objets, sans schéma ni port (voir infra/deploy/Caddyfile) — doit
# pointer vers ce serveur en DNS avant le premier démarrage de Caddy (challenge ACME).
MINIO_PUBLIC_ENDPOINT=objects.bresonne.example
MINIO_BUCKET=bresonne-photos
# Client interne : reste en clair sur le réseau Docker privé, rien à chiffrer entre conteneurs.
MINIO_SECURE=false
# Client public : true, Caddy termine le TLS devant lui (voir core/config.py pour pourquoi ce
# sont deux réglages distincts). Sans ça, les URLs pré-signées pointent en http et le navigateur
# les bloque (contenu mixte sur une page https).
MINIO_PUBLIC_SECURE=true
# Format "<id>:<clé base64 32 octets>" : python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MINIO_KMS_SECRET_KEY=CHANGE_ME:CHANGE_ME_32_BYTES_BASE64==

# --- Auth ---
# openssl rand -base64 48 — jamais la valeur de dev, jamais réutilisé nulle part ailleurs.
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Environnement ---
# beta : VPS de bêta fermée (l'endpoint Premium de debug y reste autorisé, voir plus bas).
# production : ouverture publique, tous les mécanismes de debug interdits. Dans les deux cas, le
# backend refuse de démarrer si un secret ci-dessous vaut encore CHANGE_ME, si DEBUG_OTP=true ou si
# l'envoi d'email n'est pas configuré (core/config.py) — une erreur de config se voit au
# démarrage, pas après coup.
ENVIRONMENT=beta

# --- Connexion par code OTP envoyé par email ---
# false sans exception hors dev : DEBUG_OTP=true renverrait le code dans la réponse API, ce qui
# annulerait toute vérification (refusé au démarrage de toute façon).
DEBUG_OTP=false
# Resend en SMTP (https://resend.com/docs/send-with-smtp) : domaine d'envoi vérifié chez Resend
# au préalable (enregistrements SPF/DKIM/DMARC en DNS), sinon Resend n'envoie qu'à l'adresse du
# compte. Choisir la région UE à la création du domaine (RGPD, voir docs/DPIA.md).
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=resend
# La clé API Resend (re_...), avec la seule permission "Sending access".
SMTP_PASSWORD=CHANGE_ME
# Une adresse du domaine vérifié chez Resend.
EMAIL_FROM=Bresonne <no-reply@CHANGE_ME>
OTP_REQUESTS_PER_IP_PER_HOUR=20

# --- Abonnement ---
# true en bêta fermée (choix produit : les testeur·se·s essaient le Premium sans payer, aucune
# intégration StoreKit/Play Billing n'existe encore) ; interdit avec ENVIRONMENT=production, où
# n'importe quel compte pourrait s'accorder le Premium via POST /subscriptions/debug-activate.
ENABLE_DEBUG_SUBSCRIPTION_ENDPOINT=true

# --- CORS ---
# Le domaine réel de l'app web (voir infra/deploy/Caddyfile), avec schéma.
CORS_ORIGINS=https://app.bresonne.example

# --- Question du jour personnalisée (service `ollama`, profil "ai") ---
# false par défaut, comme en dev : le gabarit statique reste utilisé tant que le conteneur
# ollama n'est pas démarré sur ce VPS (poids du modèle à télécharger, RAM à prévoir). Voir
# core/config.py / services/question_llm.py — un échec ou une lenteur d'Ollama ne fait jamais
# planter ce endpoint, il retombe silencieusement sur le gabarit.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=3.0

# --- Messagerie multi-instance (Redis, réseau Docker interne uniquement) ---
REDIS_URL=redis://redis:6379/0

# --- Notifications push (Web Push + VAPID) ---
# Paire de clés à générer une fois (commande dans .env.example) — propre à ce serveur.
PUSH_ENABLED=true
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_PUBLIC_KEY=CHANGE_ME
# Une vraie adresse de contact (RFC 8292), pas une valeur bidon.
VAPID_SUBJECT=mailto:CHANGE_ME

# --- Sauvegardes ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- Reverse proxy / TLS (Caddy, voir infra/deploy/Caddyfile) ---
# Email de contact pour Let's Encrypt (expiration de certificat, pas de spam) — pas de valeur
# bidon possible, Caddy l'envoie réellement à l'ACME CA.
ACME_EMAIL=toi@example.com
API_DOMAIN=api.bresonne.example
OBJECTS_DOMAIN=objects.bresonne.example
APP_DOMAIN=app.bresonne.example
